# Where the dashboard app is deployed — the Sign Up link in the header points at
# its /register page. Leave this unset in production; the default is already the
# canonical origin (https://app.inboundselect.com), which is the same fallback
# the backend uses in src/utils/resolveFrontendOrigin.js.
#
# Set it when you want the site to point at something else:
#   VITE_APP_URL=http://localhost:5174          # a dashboard running locally
#   VITE_APP_URL=https://staging.inboundselect.com
VITE_APP_URL=https://app.inboundselect.com
